&i2c0 {
        focaltech@38{ 
            pinctrl-names = "i2c0_pull_down", "i2c0_pull_up";
            pinctrl-0 = <&i2c0_pull_down_ctrl>;
            pinctrl-1 = <&i2c0_pull_up_ctrl>;
            compatible = "focaltech,fts";
            reg = <0x38>;
            interrupt-parent = <&pio>;
            interrupts = <9 IRQ_TYPE_EDGE_FALLING 9 0>;
            focaltech,reset-gpio = <&pio 152 0>; 
            focaltech,irq-gpio = <&pio 9 IRQ_TYPE_EDGE_FALLING>;
            focaltech,max-touch-number = <10>;
            focaltech,display-coords =  <0 0 1440 2200>;
        };

        //jadard@68{
        //    compatible = "jadard,jdcommon";
        //    reg = <0x68>;
        //    interrupt-parent = <&pio>;
        //    interrupts = <9 IRQ_TYPE_EDGE_FALLING 9 0>;
        //    jadard,panel-sense-nums = <30 48>;
        //    jadard,panel-coords = <0 1200 0 2000>;
        //    jadard,panel-max-points = <10>;
        //    jadard,int-is-edge = <1>;
        //    jadard,irq-gpio = <&pio 9 0>;
        //    jadard,rst-gpio = <&pio 152 0>;
        //};
		//
        //gslx680@68{
        //    compatible = "mediatek,cap_touch";
        //    reg = <0x40>;
        //    gsl,irq-gpios = <&pio 9 0>;
        //    gsl,reset-gpios = <&pio 152 0>;
        //    gsl,power-gpios = <&pio 50 0>;
        //};

        himax_ts@48 {
                compatible = "himax,hxcommon";
                reg = <0x48>;
                //himax,3v3-gpio = <&pio 174 0>;
                himax,rst-gpio = <&pio 152 0>;
                himax,irq-gpio = <&pio 9 0>;
                himax,panel-coords = <0 1200 0 2000>;
                himax,display-coords = <0 1200 0 2000>;
                report_type = <1>;
        };

        lt8911exb@25 {
            compatible = "mediatek,lt8911exb_com";
            reg = <0x25>;
            status = "okay";
        };
		
//		chipone_tddi_i2c@48 {
//            compatible = "chipone,cts";
//            reg = <0x48>;
//	      status = "ok";
//            chipone,rst-gpio = <&pio 152 0x00>;
//            chipone,irq-gpio = <&pio 9 0x00>;
//            chipone,x-res = <1200>;
//            chipone,y-res = <1920>;
//       };
};

&pio {
    i2c0_pull_down_ctrl: i2c0_pull_down_ctrl {
    pins_cmd_dat {
            pinmux = <PINMUX_GPIO130__FUNC_SCL0>,
                        <PINMUX_GPIO131__FUNC_SDA0>;
            slew-rate = <0>;
            bias-pull-down;
        };
    };

    i2c0_pull_up_ctrl: i2c0_pull_up_ctrl {
        pins_cmd_dat {
            pinmux = <PINMUX_GPIO130__FUNC_SCL0>,
                        <PINMUX_GPIO131__FUNC_SDA0>;
            slew-rate = <0>;
            bias-pull-up;
        };
    };
};


&i2c1 {
    aw87xxx@58 {
        compatible = "awinic,aw87xxx_pa";
        reg = <0x58>;
        dev_index = <0>;
        status = "okay";
    }; 
    aw87xxx@59 {
        compatible = "awinic,aw87xxx_pa";
        reg = <0x59>;
        dev_index = <3>;
        status = "okay";
    };
};


&i2c3 {
	it6112@56 {
		compatible = "ite,it6112";
		reg = <0x56>;                      
		status = "okay";
	};
};
    
&i2c6 {
