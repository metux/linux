&lk_charger{
	max_charger_voltage = <12000000>;
};


&pdc {
#if defined(M100TB_DG_P3PRO_527)
	pd_vbus_upper_bound = <9000000>;
#else
        pd_vbus_upper_bound = <12000000>;
#endif
	dcs_chg1_charger_current = <3000000>;
	dcs_chg2_charger_current = <3000000>;
};


&pe2 {
	/* dual charger in series*/
	dcs_input_current = <6000000>;
	dcs_chg1_charger_current = <3000000>;
	dcs_chg2_charger_current = <3000000>;
#if defined(M100TB_DG_P3PRO_527)
	status = "disabled";
#endif
};

&pe4 {
	/* dual charger in series*/
	dcs_input_current = <6000000>;
	dcs_chg1_charger_current = <3000000>;
	dcs_chg2_charger_current = <3000000>;
#if defined(M100TB_DG_P3PRO_527)
	status = "disabled";
#endif
};

&charger {
	/*min_charger_voltage_1 = <4300000>;*/
	/*max_dmivr_charger_current = <3000000>;*/	
	max_charger_voltage = <13000000>;
	charger_configuration= <0>;
        charger_unlimited;
#if defined(CONFIG_WB_HIGH_4V4_BATTERY_SUPPORT)
	battery_cv = <4400000>;
#elif defined(CONFIG_WB_HIGH_BATTERY_SUPPORT)
	battery_cv = <4350000>;
#else
	battery_cv = <4200000>;
#endif
};

#if 0 //ndef CONFIG_CHARGER_SC8989X
&mt6375_typec {
	pd-data {
		pd,sink-pdo-data = <0x0003c12c 0x000190c8> ;
	};
};
#endif

&accdet {
	headset-eint-level-pol = <8>;
};

&mmc1 {
	host-index = <1>;
	status = "okay";
	pinctrl-names = "default", "state_uhs", "pull_down";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	pinctrl-2 = <&mmc1_pins_pull_down>;
	bus-width = <4>;
	max-frequency = <200000000>;
	ocr-voltage = <0x00030000>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	cd-debounce-delay-ms = <0>;
	cd-gpios = <&pio 7 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6358_vmch_eint_low>;
	vqmmc-supply = <&mt6358_vmc_reg>;
	no-mmc;
	dvfsrc-vcore-supply = <&dvfsrc_vcore>;
	req-vcore = <650000>;
};

&pio {
	mmc1_pins_default: mmc1default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO73__FUNC_MSDC1_DAT0>,
				<PINMUX_GPIO74__FUNC_MSDC1_DAT1>,
				<PINMUX_GPIO75__FUNC_MSDC1_DAT2>,
				<PINMUX_GPIO76__FUNC_MSDC1_DAT3>,
				<PINMUX_GPIO72__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <3>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <PINMUX_GPIO71__FUNC_MSDC1_CLK>;
			drive-strength = <3>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};
	mmc1_pins_uhs: mmc1@0{
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO73__FUNC_MSDC1_DAT0>,
				<PINMUX_GPIO74__FUNC_MSDC1_DAT1>,
				<PINMUX_GPIO75__FUNC_MSDC1_DAT2>,
				<PINMUX_GPIO76__FUNC_MSDC1_DAT3>,
				<PINMUX_GPIO72__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <3>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins_clk {
			pinmux = <PINMUX_GPIO71__FUNC_MSDC1_CLK>;
			drive-strength = <3>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};
	mmc1_pins_pull_down: mmc1@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO73__FUNC_MSDC1_DAT0>,
				<PINMUX_GPIO74__FUNC_MSDC1_DAT1>,
				<PINMUX_GPIO75__FUNC_MSDC1_DAT2>,
				<PINMUX_GPIO76__FUNC_MSDC1_DAT3>,
				<PINMUX_GPIO72__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <3>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins_clk {
			pinmux = <PINMUX_GPIO71__FUNC_MSDC1_CLK>;
			drive-strength = <3>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};

};

//trustkernel L1 patch start
&reserved_memory {
        tkcore_shared_mem {
                compatible ="trustkernel,shared_mem";
                no-map;
                size = <0 0x1000000>;
                alignment = <0 0x1000>;
                alloc-ranges = <0 0x40000000 0 0x80000000>;
        };
        MTEE {
                no-map;
                size = <0 0x100000>;
                alignment = <0 0x100000>;
        };
        SecureVideoPath {
                compatible = "mediatek,mtk_sec_video_path_support";
        };
};
//trustkernel L1 patch end


