&leds{
	red {
		label = "red";
		gpios = <&pio 99 0x0>;
		default-state = "off";
	};

	green {
		label = "green";
		gpios = <&pio 98 0x0>;
		default-state = "off";
	};

	blue {
		label = "blue";
		gpios = <&pio 5 0x0>;
		default-state = "off";
	};
};

&lk_charger{
	max_charger_voltage = <13000000>;
};

&charger{
    battery_cv = <4450000>;
    charger = <&sc8989x_chg>;
    max_charger_voltage = <13000000>;
    charger_configuration= <0>;
};

&mtk_gauge {
	charger = <&sc8989x_chg>;
};

&extcon_usb {
	charger = <&sc8989x_chg>;
	id-gpios = <&pio 13 0x0>;
};

&accdet{
	/*1:ACC mode, 2:low cost without in bias, 6:low cost with in bias*/
	accdet-mic-mode = <1>;
	/* eint_level_trigger: 8,LEVEL_LOW(DEF) ;4,LV_HIGH;others,LV_LOW */
	headset-eint-level-pol = <8>;
};

#include <tb8781p1_64/cust.dtsi>
