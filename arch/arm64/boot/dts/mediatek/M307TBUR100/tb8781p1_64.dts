&pio {
    i2c0_pull_down_ctrl: i2c0_pull_down_ctrl {
    pins_cmd_dat {
            pinmux = <PINMUX_GPIO130__FUNC_SCL0>,
                        <PINMUX_GPIO131__FUNC_SDA0>;
            slew-rate = <0>;
            bias-pull-down;
        };
    };

    i2c0_pull_up_ctrl: i2c0_pull_up_ctrl {
        pins_cmd_dat {
            pinmux = <PINMUX_GPIO130__FUNC_SCL0>,
                        <PINMUX_GPIO131__FUNC_SDA0>;
            slew-rate = <0>;
            bias-pull-up;
        };
    };
};

&i2c1 {
    aw87xxx@58 {
        compatible = "awinic,aw87xxx_pa";
        reg = <0x58>;
        dev_index = <0>;
        status = "okay";
    }; 
    aw87xxx@59 {
        compatible = "awinic,aw87xxx_pa";
        reg = <0x59>;
        dev_index = <3>;
        status = "okay";
    };
};

&i2c3 {
	it6112@56 {
		compatible = "ite,it6112";
		reg = <0x56>;
		status = "okay";
	};

	ocp96011@42 {
		status = "okay";
		compatible = "ocp96011";
		tcpc = "type_c_port0";
		reg = <0x42>;
	};

	st21nfc: st21nfc@08 {
		compatible = "st,st21nfc";
		reg = <0x08>;
		interrupt-parent = <&pio>;
		interrupts = <4 0>;
		reset-gpios = <&pio 3 0x00>;
		irq-gpios = <&pio 4 0x00>;
		clkreq-gpios = <&pio 68 0x00>;
		status = "disabled";
	};

};

&cust_i2c {
	pinctrl-names = "pull_up", "pull_down";
	pinctrl-0 = <&i2c_pull_up>;
	pinctrl-1 = <&i2c_pull_down>;
	status = "okay";
};

&pio {
	i2c_pull_down: i2c_pull_down {
	pins_cmd_dat {
			pinmux = <PINMUX_GPIO136__FUNC_GPIO136>,
						<PINMUX_GPIO137__FUNC_GPIO137>;
			slew-rate = <1>;
			output-low;
		};
	};

	i2c_pull_up: i2c_pull_up {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO136__FUNC_SCL3>,
						<PINMUX_GPIO137__FUNC_SDA3>;
			slew-rate = <0>;
			bias-pull-up;
		};
	};
};

&i2c6 {
	/*clock-frequency = <1000000>;*/
	status = "okay";

	aw87xxx@58 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x58>;
		dev_index = <1>;
		status = "okay";
	}; 
    aw87xxx@59 {
        compatible = "awinic,aw87xxx_pa";
        reg = <0x59>;
        dev_index = <2>;
        status = "okay";
    };
};

&lk_charger{
	max_charger_voltage = <10000000>;
	ac_charger_current = <3600000>;
	ac_charger_input_current = <2000000>;
};

&leds{
	red {
		label = "red";
		gpios = <&pio 45 0x0>;
		default-state = "off";
                retain-state-suspended;
	};

	green {
		label = "green";
		gpios = <&pio 44 0x0>;
		default-state = "off";
                retain-state-suspended;
	};

	blue {
		label = "blue";
		gpios = <&pio 42 0x0>;
		default-state = "off";
                retain-state-suspended;
	};

	keyboard-backlight {
		label = "keyboard-backlight";
		gpios = <&pio 53 0x0>;
		default-state = "off";
		retain-state-suspended;
	};
};
&pd_adapter{
	status = "disabled";
};
&pdc {
	pd_vbus_upper_bound = <9000000>;
	status = "disabled";
};

&pe{
status = "disabled";
};

/*
&pe2 {
status = "disabled";
};
*/

&pe4 {
status = "disabled";
};

&pe45{
status = "disabled";
};
&charger {
	max_charger_voltage = <11000000>;
	charger_configuration = <0>;
	charger_unlimited;
	battery_cv = <4350000>;
	min_charge_temp = <(-15)>;
	min_charge_temp_plus_x_degree = <(-12)>;
	max_charge_temp = <55>;
	max_charge_temp_minus_x_degree = <52>;
	io-channels = <&auxadc 3>;
	io-channel-names = "pmic_vbus";
};

&accdet {
	headset-eint-level-pol = <8>;
};

#include "mediatek/M307TBUR100/aw35615.dtsi"
