&lk_charger{
	max_charger_voltage = <12000000>;
};

&charger{
    battery_cv = <4350000>;
    charger = <&upm6920_chg>;
    max_charger_voltage = <12000000>;
};

&mtk_gauge {
	charger = <&upm6920_chg>;
};

&extcon_usb {
	charger = <&upm6920_chg>;
	id-gpios = <&pio 13 0x0>;
};

&accdet{
	/*1:ACC mode, 2:low cost without in bias, 6:low cost with in bias*/
	accdet-mic-mode = <1>;
	/* eint_level_trigger: 8,LEVEL_LOW(DEF) ;4,LV_HIGH;others,LV_LOW */
	headset-eint-level-pol = <8>;
};

&pe4 {
	status = "disabled";
};

&pe2 {
	status = "disabled";
};

&pe {
	status = "disabled";
};

&pdc {
	status = "disabled";
