&i2c7 {
	aw882xx_smartpa_0: aw882xx_smartpa_0@35 {
		compatible = "awinic,aw882xx_smartpa";
		reg = <0x35>;
		#sound-dai-cells = <0>;
		//reset-gpio = <&pio 49 0>;/*aw88230,aw88257,aw88261,aw88265 no need*/
		irq-gpio = <&pio 10 0>;//AA5
		sync-load = <0>;//1:ko 0:boot
		sound-channel = <0>;/*0:pri_l 1:pri_r 2:sec_l 3:sec_r*/
		aw-re-min = <4000>;
		aw-re-max= <30000>;
		//rename-flag = <1>;
		status = "okay";
	};

	aw882xx_smartpa_1: aw882xx_smartpa_1@34 {
		compatible = "awinic,aw882xx_smartpa";
		reg = <0x34>;
		#sound-dai-cells = <0>;
		//reset-gpio = <&pio 49 0>;/*aw88230,aw88257,aw88261,aw88265 no need*/
		irq-gpio = <&pio 3 0>;//AA5
		sync-load = <0>;//1:ko 0:boot
		sound-channel = <1>;/*0:pri_l 1:pri_r 2:sec_l 3:sec_r*/
		aw-re-min = <4000>;
		aw-re-max= <30000>;
		//rename-flag = <1>;
		status = "okay";
	};
};

&sound {
	//mediatek,spk-i2s = <3 0>;
	//mediatek,spk-i2s = <1 2>;
	mediatek,speaker-codec {
		sound-dai = <&aw882xx_smartpa_0 &aw882xx_smartpa_1>;
	};
};
    
