#
# Novatek NT36xxx touchscreen driver configuration
#
config TOUCHSCREEN_NT36xxx_HOSTDL_SPI
	tristate "Novatek NT36xxx host download SPI driver"
	default y
	help
	  Say Y here if you have a Novatek NT36xxx no flash touchscreen connected
	  to your system by SPI bus.

	  If unsure, say N.

config TOUCHSCREEN_NT36xxx_SPI_X_REVERSE
	bool "NT36xxx driver coor x reverse"
	depends on TOUCHSCREEN_NT36xxx_HOSTDL_SPI
	help
	  This enables support for NT36xxx driver coor x reverse.

config TOUCHSCREEN_NT36xxx_SPI_Y_REVERSE
	bool "NT36xxx driver coor y reverse"
	depends on TOUCHSCREEN_NT36xxx_HOSTDL_SPI
	help
	  This enables support for NT36xxx driver coor y reverse.